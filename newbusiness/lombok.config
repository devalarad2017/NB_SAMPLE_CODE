# Lombok configuration for the module.
# stopBubbling marks this as the root so Lombok doesn't look further up the tree.
config.stopBubbling = true

# Copy Spring injection annotations from fields onto the constructor parameters that
# Lombok's @RequiredArgsConstructor generates. This lets us use clean, all-final
# constructor injection while still honouring @Value (config), @Qualifier (bean
# disambiguation) and @Lazy (breaks the self-injection cycle in NewBusinessService).
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
